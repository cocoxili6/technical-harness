# 填入 DeepSeek 的 API Key 后，服务自动切换到真实模型模式
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：允许的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 可选：arXiv 检索端点（一般不用改）
ARXIV_ENDPOINT=https://export.arxiv.org/api/query

# 可选：Serper.dev API Key（检索 Google Scholar）。留空则智能体只有 arXiv 工具
SERPER_API_KEY=

# 可选：OpenAlex API Key。留空也能用，但会与同一 IP 共享免费额度
OPENALEX_API_KEY=

# 上下文管理：历史超过 token 预算时，把较早轮次压缩成纪要，只保留最近 N 轮原文
CONTEXT_TOKEN_BUDGET=28000
CONTEXT_KEEP_TURNS=2
CONTEXT_CATALOG_LIMIT=40

# Supabase 项目配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# 使用 Supabase Database -> Connect -> Connection pooling 的 session pooler URL
# 将 postgres:// 替换为 postgresql+asyncpg://，并对密码中的特殊字符做 URL 编码
SUPABASE_DB_URL=postgresql+asyncpg://postgres.project-ref:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Edge Function 与 FastAPI 共用的长随机字符串
HARNESS_SHARED_TOKEN=
